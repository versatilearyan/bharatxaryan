# Copy to .env.local and fill in. Restart `npm run dev` after any change.

# Panchayat backend. The app forwards its /backend/... calls here, so the
# browser never talks to ngrok directly (no CORS setup needed). The ngrok URL
# changes each time the tunnel restarts: update it here (or the default in
# lib/config.ts) and restart `npm run dev`. With or without /api/v1 both work.
BACKEND_URL=https://api.panchayat.world/

# Google OAuth *Web* client ID (ends in .apps.googleusercontent.com). Public by
# design. Never put the client secret in the frontend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=688204337983-ao5gnds2t1p6tq0qn5m9p53ttoo9t1mt.apps.googleusercontent.com

# Sends "ngrok-skip-browser-warning: 1" with every API call (default true).
# Set false when the backend is no longer behind ngrok.
NEXT_PUBLIC_SEND_NGROK_HEADER=true

# Chess game server (the chess-server/ folder). Must be wss:// when the app is
# served over https. Default ws://localhost:8090.
NEXT_PUBLIC_CHESS_WS_URL=ws://localhost:8090
